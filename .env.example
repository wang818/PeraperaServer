# Application Settings
APP_NAME=PeraperaServer
APP_VERSION=1.0.0
DEBUG=True

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database Settings
# Format: postgresql+asyncpg://username:password@host:port/database_name
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/perapera_db

# Security Settings
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Email Settings
# For Gmail, use app-specific password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=PeraperaServer

# Tencent Cloud SES Settings (优先于 SMTP 发送; 个人实名账号建议走此通道)
# 密钥可复用 COS 的 SecretId/SecretKey
SES_SECRET_ID=
SES_SECRET_KEY=
SES_REGION=ap-guangzhou
SES_FROM_EMAIL=your-verified-sender@mail.qcloud.com
# 语言代码 -> 模板ID (JSON)，例如 {"zh-CN":213037}
SES_TEMPLATE_IDS=

# RapidAPI Settings
# Get your key from: https://rapidapi.com/ytjar/api/youtube-mp36
RAPIDAPI_KEY=your-rapidapi-key-here

# Tencent Cloud COS Settings
COS_SECRET_ID=your-cos-secret-id-here
COS_SECRET_KEY=your-cos-secret-key-here
COS_BUCKET=perapera-1255314189
COS_REGION=ap-tokyo
COS_UPLOAD_PREFIX=audios/

# apple pay
APPLE_IAP_ISSUER_ID=your-issuer-id
APPLE_IAP_KEY_ID=your-key-id
APPLE_IAP_PRIVATE_KEY=your-private-key
APPLE_IAP_BUNDLE_ID=your-bundle-id
APPLE_IAP_APP_SHARED_SECRET=your-app-shared-secret
APPLE_IAP_ENVIRONMENT=sandbox